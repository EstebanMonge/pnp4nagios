<link rel="stylesheet" href="@PNP_URL@/media/css/ui-smoothness/jquery-ui.css" type="text/css" />
<style type="text/css">
.ui-tooltip { position: absolute; z-index: 9999; max-width: none; padding: 4px; background: #fff; border: 1px solid #aaa; box-shadow: 0 0 6px rgba(0,0,0,.4); }
</style>
<script src="@PNP_URL@/media/js/jquery-3.7.1.min.js" type="text/javascript"></script>
<script src="@PNP_URL@/media/js/jquery-ui-1.14.1.min.js" type="text/javascript"></script>
<script type="text/javascript">
jQuery.noConflict();
jQuery(document).ready(function() {
  jQuery('a.tips').tooltip({
    items: 'a.tips',
    show: { delay: 200 },
    content: function(callback) {
      jQuery.ajax({ url: jQuery(this).attr('rel'), cache: false, success: function(data) { callback(data); } });
    }
  });
});
</script>
